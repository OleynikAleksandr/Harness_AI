{
  "name": "harness-ai",
  "version": "0.0.0",
  "description": "Standalone AI product-development workspace app.",
  "author": "Oleksandr Oliinyk",
  "private": true,
  "type": "module",
  "main": "product-parts/application-shell/clusters/electron-host/modules/app-bootstrap/src/main.mjs",
  "scripts": {
    "dev": "node scripts/dev-electron.mjs",
    "dev:renderer": "vite --host 127.0.0.1",
    "electron:start": "npm run build && electron product-parts/application-shell/clusters/electron-host/modules/app-bootstrap/src/main.mjs",
    "build": "npm run typecheck && npm run build:runtime && vite build",
    "build:runtime": "tsc --project tsconfig.runtime.json",
    "package:mac": "npm run build && electron-builder --mac dir --publish never",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "git config core.hooksPath .husky",
    "plan:status": "node scripts/plan.mjs status",
    "plan:validate": "node scripts/plan.mjs validate",
    "plan:repair": "node scripts/plan.mjs repair",
    "plan:commit": "node scripts/plan.mjs commit",
    "plan:archive": "node scripts/plan.mjs archive",
    "check:architecture": "node scripts/check-architecture.mjs",
    "lint": "ultracite check",
    "format:fix": "ultracite fix",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "check:knip": "knip",
    "check:dup": "npm run -s check:dup:repo && npm run -s check:dup:workspace",
    "check:dup:repo": "jscpd --threshold 3 --silent --reporters console product-parts scripts --ignore \"**/node_modules/**,**/dist/**,**/release/**,**/*.test.mjs\"",
    "check:dup:workspace": "jscpd --threshold 4 --silent --reporters console product-parts scripts docs .harness --ignore \"**/node_modules/**,**/dist/**,**/release/**,**/.harness/runtime/**,**/*.test.mjs\"",
    "check:links": "node scripts/check-links.mjs",
    "check:security": "npm audit --omit=dev --audit-level=high",
    "check:security:all": "npm audit --audit-level=high",
    "quality": "npm run check:architecture && npm run lint && npm run check:knip && npm run typecheck && npm test",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.17.11",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "jscpd": "^4.0.5",
    "knip": "^6.1.0",
    "markdown-link-check": "^3.14.2",
    "typescript": "^6.0.3",
    "ultracite": "^7.3.2",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "ai.harness.desktop",
    "productName": "Harness AI",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**",
      "dist/runtime/**",
      "product-parts/application-shell/clusters/electron-host/modules/app-bootstrap/src/**",
      "product-parts/application-shell/clusters/electron-host/modules/core-process-bridge/src/**",
      "product-parts/application-shell/clusters/electron-host/modules/vscode-link-opener/src/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "ultracite fix"
    ]
  }
}
